# Your prompts, outputs and verdicts. Local working data, not source.
# See DECISIONS.md.
backend/data/

# The scheduling example's own run folder (see backend/examples/).
backend/runs/*
!backend/runs/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Node
node_modules/
dist/
.vite/
*.log

# Local model configuration. Never commit credentials.
# The wildcard covers backups like .env.bak-2026-09-21: a copy of a working
# .env is the usual way a key reaches git history by accident.
.env
.env.*
backend/.env
backend/.env.*
!.env.example
!backend/.env.example

# Editor and OS noise
.DS_Store
.idea/
.vscode/

# Scratch holding pen for files staged for deletion, and transfer archives
_to_delete/
*.tar.gz

# Per-machine assistant settings; not shared configuration.
.claude/settings.local.json
