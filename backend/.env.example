# Copy to backend/.env and fill in to point MITSS at your own model.
# Leave MITSS_LLM_PROVIDER unset (or "manual") to keep the paste-back workflow.
#
# This file is an example only. Never commit a real key: backend/.env is
# gitignored, and the harness reads these at call time without storing them.

# manual (default) | http
MITSS_LLM_PROVIDER=http

# Endpoint your model listens on.
#   llama.cpp / vLLM / LM Studio:  http://127.0.0.1:8080/v1/chat/completions
#   Ollama (openai-compatible):    http://127.0.0.1:11434/v1/chat/completions
MITSS_LLM_URL=http://127.0.0.1:8080/v1/chat/completions

# openai (chat-completions shape) | raw ({"prompt": ...})
MITSS_LLM_FORMAT=openai

# Model name sent in the request body.
MITSS_LLM_MODEL=my-custom-model

# Optional. Sent as "Authorization: Bearer <key>".
# MITSS_LLM_API_KEY=

# Seconds to wait for a completion.
MITSS_LLM_TIMEOUT=120

# Where runs/ and inputs/ live. Defaults to the backend folder.
# MITSS_ROOT=

# Extra origins allowed to call the API, comma separated.
# MITSS_CORS_ORIGINS=http://localhost:5173
