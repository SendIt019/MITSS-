{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(date)",
      "Bash(date *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!.env.example)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.config/gh/**)",
      "Read(~/.cache/huggingface/token)",
      "Read(~/.cache/huggingface/stored_tokens)",
      "Read(~/Library/Keychains/**)",
      "Bash(sudo *)",
      "Bash(security *)",
      "Bash(hf auth *)",
      "Bash(huggingface-cli login *)",
      "Bash(gh auth *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(rm *)",
      "Bash(mlx_lm.server *)",
      "Bash(*/mlx_lm.server *)",
      "Bash(mlx_lm.generate *)",
      "Bash(*/mlx_lm.generate *)",
      "Bash(*start_model_server.sh)",
      "Bash(*start_model_server.sh *)",
      "Bash(*run_matrix* run *)",
      "Bash(*run_matrix* resume *)"
    ]
  }
}
